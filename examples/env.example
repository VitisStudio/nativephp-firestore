# --- Option A: a real Firebase project -------------------------------------
# Drop GoogleService-Info.plist / google-services.json in the project root
# (or point FIREBASE_IOS_CONFIG_PATH / FIREBASE_ANDROID_CONFIG_PATH at them)
# and you need nothing else here.

# --- Option B: explicit options instead of the files -----------------------
# FIREBASE_PROJECT_ID=my-project
# FIREBASE_API_KEY=AIza...
# FIREBASE_SENDER_ID=1234567890
# FIREBASE_IOS_APP_ID=1:1234567890:ios:abc123
# FIREBASE_ANDROID_APP_ID=1:1234567890:android:abc123
# FIREBASE_STORAGE_BUCKET=my-project.appspot.com

# --- Option C: Emulator Suite with a demo project (no Firebase account) ----
#   firebase emulators:start --only firestore,auth --project demo-notes
FIREBASE_PROJECT_ID=demo-notes
FIREBASE_EMULATOR=true
# Leave the hosts empty for simulator/emulator defaults (127.0.0.1 / 10.0.2.2);
# set your Mac's LAN IP for a physical device.
# FIRESTORE_EMULATOR_HOST=
# FIRESTORE_EMULATOR_PORT=8080
# FIREBASE_AUTH_EMULATOR_HOST=
# FIREBASE_AUTH_EMULATOR_PORT=9099

# --- Tuning -----------------------------------------------------------------
# FIRESTORE_PERSISTENCE=true
# FIRESTORE_CACHE_SIZE_BYTES=104857600
# FIRESTORE_WAIT_FOR_SERVER=false
# FIRESTORE_SERVER_TIMESTAMPS=estimate
# FIRESTORE_TIMEOUT=15
